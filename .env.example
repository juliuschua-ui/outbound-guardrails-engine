# Environment variables the engine reads. NAMES ONLY, no real values.
# The engine holds no secrets. Gmail OAuth tokens (used only to create DRAFTS)
# live outside this repo and are referenced by path, never copied here.

# Absolute path to the SQLite database. Default: <repo>/data/dm.db
# Must resolve inside the repo (or a temp dir when DM_ENGINE_TEST=1).
DM_ENGINE_DB=

# Set to 1 to run in test mode: the Gmail helper refuses to build a real service
# and the db_path guard tightens. pytest sets this for the whole session.
DM_ENGINE_TEST=

# Where `metrics-emit` and the approval cards are written. Point these at a
# temp dir (or data/demo-out/...) to rehearse the pipeline without touching
# any dashboard that reads them.
DM_ENGINE_DASHBOARD_METRICS_DIR=
DM_ENGINE_DASHBOARD_APPROVALS_DIR=
